<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tampilan Form Input Template -->
        <record id="view_pos_template_form" model="ir.ui.view">
            <field name="name">pos.integration.template.form</field>
            <field name="model">pos.integration.template</field>
            <field name="arch" type="xml">
                <form string="Pengaturan Template CSV">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Nama Sumber PoS (Misal: Majoo)"/>
                            <h1><field name="name" placeholder="Ketik nama PoS..."/></h1>
                        </div>
                        <notebook>
                            <page string="Mapping Kolom CSV">
                                <!-- tabel input di dalam form -->
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="odoo_field"/>
                                        <field name="csv_column_name"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List (Daftar Template) -->
        <record id="view_pos_template_tree" model="ir.ui.view">
            <field name="name">pos.integration.template.list</field>
            <field name="model">pos.integration.template</field>
            <field name="arch" type="xml">
                <list string="Daftar Template">
                    <field name="name"/>
                </list>
            </field>
        </record>
    </data>
</odoo>