<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pos_integration_log_tree" model="ir.ui.view">
            <field name="name">pos.integration.log.list</field>
            <field name="model">pos.integration.log</field>
            <field name="arch" type="xml">
                <!-- create="false" edit="false" delete="false" agar log tidak bisa dimanipulasi -->
                <list string="Riwayat Import" create="false" edit="false" delete="false">
                    <field name="import_date"/>
                    <field name="user_id"/>
                    <field name="source_type"/>
                    <field name="pos_system_id"/>
                    <field name="template_id"/>
                    <field name="filename"/>
                    <field name="success_count"/>
                    <field name="skipped_count"/>
                    <field name="failed_count"/>
                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state == 'partial'" decoration-danger="state == 'failed'" decoration-muted="state == 'undone'"/>
                    
                    <button name="action_undo_import" type="object" string="Batal Import" class="btn-sm btn-danger" icon="fa-undo" confirm="Anda yakin ingin membatalkan import ini? Semua data penjualan terkait akan langsung Dihapus dari database." invisible="state in ('undone', 'failed')"/>
                </list>
            </field>
        </record>

        <record id="view_pos_integration_log_form" model="ir.ui.view">
            <field name="name">pos.integration.log.form</field>
            <field name="model">pos.integration.log</field>
            <field name="arch" type="xml">
                <form string="Detail Log Integrasi" create="false" edit="false" delete="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="import_date"/>
                                <field name="user_id"/>
                                <field name="source_type"/>
                                <field name="state"/>
                            </group>
                            <group>
                                <field name="pos_system_id"/>
                                <field name="template_id"/>
                                <field name="filename"/>
                            </group>
                        </group>
                        <group>
                            <field name="success_count"/>
                            <field name="skipped_count"/>
                            <field name="failed_count"/>
                        </group>
                        <group>
                            <field name="error_message"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_pos_integration_log_search" model="ir.ui.view">
            <field name="name">pos.integration.log.search</field>
            <field name="model">pos.integration.log</field>
            <field name="arch" type="xml">
                <search string="Cari Log Integrasi">
                    <field name="pos_system_id"/>
                    <field name="template_id"/>
                    <field name="filename"/>
                    <filter name="filter_api" string="API" domain="[('source_type', '=', 'api')]"/>
                    <filter name="filter_csv" string="CSV" domain="[('source_type', '=', 'csv')]"/>
                    <filter name="filter_failed" string="Gagal" domain="[('state', '=', 'failed')]"/>
                    <filter name="filter_partial" string="Sebagian Berhasil" domain="[('state', '=', 'partial')]"/>
                </search>
            </field>
        </record>

        <!-- Action untuk memanggil tampilan List -->
        <record id="action_pos_integration_log" model="ir.actions.act_window">
            <field name="name">Sistem Logging</field>
            <field name="res_model">pos.integration.log</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
