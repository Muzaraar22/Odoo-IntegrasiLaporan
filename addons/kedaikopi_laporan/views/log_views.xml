<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pos_integration_log_tree" model="ir.ui.view">
            <field name="name">pos.integration.log.list</field>
            <field name="model">pos.integration.log</field>
            <field name="arch" type="xml">
                <!-- create="false" edit="false" delete="false" agar log tidak bisa dimanipulasi -->
                <list string="Riwayat Import" create="false" edit="false" delete="false">
                    <field name="import_date"/>
                    <field name="user_id"/>
                    <field name="template_id"/>
                    <field name="filename"/>
                    <field name="success_count"/>
                    <field name="skipped_count"/>
                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-muted="state == 'undone'"/>
                    
                    <button name="action_undo_import" type="object" string="Batal Import" class="btn-sm btn-danger" icon="fa-undo" confirm="Anda yakin ingin membatalkan import ini? Semua data penjualan terkait akan langsung Dihapus dari database." invisible="state == 'undone'"/>
                </list>
            </field>
        </record>

        <!-- Action untuk memanggil tampilan List -->
        <record id="action_pos_integration_log" model="ir.actions.act_window">
            <field name="name">Sistem Logging</field>
            <field name="res_model">pos.integration.log</field>
            <field name="view_mode">list</field>
        </record>
    </data>
</odoo>