<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pos_system_tree" model="ir.ui.view">
            <field name="name">pos.system.list</field>
            <field name="model">pos.system</field>
            <field name="arch" type="xml">
                <list string="Daftar Sistem PoS">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="floor"/>
                    <field name="auto_sync_enabled"/>
                    <field name="sync_time"/>
                    <field name="sync_endpoint_url"/>
                    <field name="active"/>
                    <field name="last_sync_at"/>
                    <field name="last_status" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_pos_system_form" model="ir.ui.view">
            <field name="name">pos.system.form</field>
            <field name="model">pos.system</field>
            <field name="arch" type="xml">
                <form string="Sistem PoS">
                    <header>
                        <button name="action_sync_now" type="object" string="Sync Sekarang" class="btn-primary" icon="fa-refresh"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="floor"/>
                                <field name="sync_endpoint_url"/>
                                <field name="auto_sync_enabled"/>
                                <field name="sync_time"/>
                            </group>
                            <group>
                                <field name="api_token"/>
                                <field name="active"/>
                                <field name="last_auto_sync_key" readonly="1"/>
                                <field name="last_sync_at" readonly="1"/>
                                <field name="last_status" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_pos_system" model="ir.actions.act_window">
            <field name="name">Sistem PoS</field>
            <field name="res_model">pos.system</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
