<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_penjualan_gabungan" model="ir.actions.act_window">
            <field name="name">Data Penjualan</field>
            <field name="res_model">penjualan.gabungan</field>
            <field name="view_mode">list,pivot,graph,form</field>
        </record>

        <record id="action_template_csv" model="ir.actions.act_window">
            <field name="name">Template CSV PoS</field>
            <field name="res_model">pos.integration.template</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_kedaikopi_root" 
                  name="Integrasi PoS" 
                  sequence="10"
                  groups="kedaikopi_laporan.group_kedaikopi_it,kedaikopi_laporan.group_kedaikopi_opras,kedaikopi_laporan.group_kedaikopi_ceo,kedaikopi_laporan.group_kedaikopi_store_manager"/>

        <menuitem id="menu_kedaikopi_penjualan" 
                  name="Laporan Penjualan" 
                  parent="menu_kedaikopi_root" 
                  action="action_penjualan_gabungan" 
                  sequence="10"
                  groups="kedaikopi_laporan.group_kedaikopi_opras,kedaikopi_laporan.group_kedaikopi_ceo"/> <menuitem id="menu_kedaikopi_konfigurasi" 
                  name="Konfigurasi" 
                  parent="menu_kedaikopi_root" 
                  sequence="20"
                  groups="kedaikopi_laporan.group_kedaikopi_opras,kedaikopi_laporan.group_kedaikopi_it,kedaikopi_laporan.group_kedaikopi_store_manager"/>

        <menuitem id="menu_kedaikopi_pos_system" 
                  name="Sistem PoS" 
                  parent="menu_kedaikopi_konfigurasi" 
                  action="action_pos_system" 
                  sequence="5"
                  groups="kedaikopi_laporan.group_kedaikopi_opras,kedaikopi_laporan.group_kedaikopi_it,kedaikopi_laporan.group_kedaikopi_store_manager"/>

        <menuitem id="menu_kedaikopi_import" 
                  name="Import Laporan" 
                  parent="menu_kedaikopi_root" 
                  action="action_import_csv_wizard" 
                  sequence="15"
                  groups="kedaikopi_laporan.group_kedaikopi_opras,kedaikopi_laporan.group_kedaikopi_store_manager"/>

        <menuitem id="menu_kedaikopi_template" 
                  name="Template CSV" 
                  parent="menu_kedaikopi_konfigurasi" 
                  action="action_template_csv" 
                  sequence="10"
                  groups="kedaikopi_laporan.group_kedaikopi_opras,kedaikopi_laporan.group_kedaikopi_store_manager"/>

        <menuitem id="menu_kedaikopi_log" 
                  name="Riwayat Logging" 
                  parent="menu_kedaikopi_konfigurasi" 
                  action="action_pos_integration_log" 
                  sequence="20"
                  groups="kedaikopi_laporan.group_kedaikopi_opras,kedaikopi_laporan.group_kedaikopi_it,kedaikopi_laporan.group_kedaikopi_store_manager"/>
    </data>
</odoo>